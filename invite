<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Приглашение</title>
    <link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Montserrat:wght@300;500&display=swap" rel="stylesheet">
    
    <style>

        body {
            margin: 0;
            padding: 0;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: linear-gradient(135deg, #fdfbfb 0%, #ebedee 100%);
            background-color: #ffe6e9; 
            font-family: 'Montserrat', sans-serif;
            overflow: hidden;
            position: relative;
        }


        .decoration {
            position: absolute;
            top: 0;
            bottom: 0;
            width: 150px;
            pointer-events: none;
            z-index: 1;
            opacity: 0.6;
        }

        .left-decor {
            left: 0;
            background: radial-gradient(circle at 0% 50%, rgba(255, 183, 197, 0.4), transparent 70%),
                        radial-gradient(circle at 10% 20%, rgba(255, 105, 180, 0.2), transparent 50%);
            border-right: 2px solid rgba(255, 255, 255, 0.5);
        }

        .right-decor {
            right: 0;
            background: radial-gradient(circle at 100% 50%, rgba(255, 183, 197, 0.4), transparent 70%),
                        radial-gradient(circle at 90% 80%, rgba(255, 105, 180, 0.2), transparent 50%);
            border-left: 2px solid rgba(255, 255, 255, 0.5);
        }


        .heart-container {
            position: relative;
            z-index: 10;
            cursor: pointer;
            transition: transform 0.3s ease;
        }

        .heart-container:hover {
            transform: scale(1.1);
        }


        .heart {
            background-color: #ff4d6d;
            display: inline-block;
            height: 50px;
            margin: 0 10px;
            position: relative;
            transform: rotate(-45deg);
            width: 50px;
            animation: heartbeat 1.2s infinite;
            box-shadow: 0 0 20px rgba(255, 77, 109, 0.6);
        }

        .heart:before,
        .heart:after {
            content: "";
            background-color: #ff4d6d;
            border-radius: 50%;
            height: 50px;
            position: absolute;
            width: 50px;
        }

        .heart:before {
            top: -25px;
            left: 0;
        }

        .heart:after {
            left: 25px;
            top: 0;
        }


        @keyframes heartbeat {
            0% { transform: rotate(-45deg) scale(1); }
            14% { transform: rotate(-45deg) scale(1.1); }
            28% { transform: rotate(-45deg) scale(1); }
            42% { transform: rotate(-45deg) scale(1.1); }
            70% { transform: rotate(-45deg) scale(1); }
        }

        .click-hint {
            text-align: center;
            margin-top: 40px;
            color: #888;
            font-size: 14px;
            letter-spacing: 2px;
            animation: fadeText 2s infinite alternate;
        }

        @keyframes fadeText {
            from { opacity: 0.5; }
            to { opacity: 1; }
        }

        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(5px);
            display: flex;
            justify-content: center;
            align-items: center;
            opacity: 0;
            visibility: hidden;
            transition: all 0.5s ease;
            z-index: 100;
        }

        .modal-overlay.active {
            opacity: 1;
            visibility: visible;
        }

        .modal-content {
            background: white;
            padding: 40px;
            border-radius: 20px;
            text-align: center;
            max-width: 90%;
            width: 400px;
            position: relative;
            box-shadow: 0 15px 30px rgba(0,0,0,0.2);
            transform: translateY(50px);
            transition: transform 0.5s ease;
            border: 2px solid #ffb7c5;
        }

        .modal-overlay.active .modal-content {
            transform: translateY(0);
        }

        .modal-title {
            font-family: 'Great Vibes', cursive;
            font-size: 3rem;
            color: #d63384;
            margin: 0 0 20px 0;
        }

        .modal-text {
            font-size: 1.1rem;
            line-height: 1.6;
            color: #555;
            margin-bottom: 30px;
        }

        .details-box {
            background: #fff0f3;
            padding: 15px;
            border-radius: 10px;
            margin-bottom: 20px;
            border: 1px dashed #d63384;
        }

        .close-btn {
            background: #ff4d6d;
            color: white;
            border: none;
            padding: 10px 30px;
            border-radius: 25px;
            font-size: 1rem;
            cursor: pointer;
            transition: background 0.3s;
            font-family: 'Montserrat', sans-serif;
        }

        .close-btn:hover {
            background: #d63384;
        }

        /* Адаптив для телефонов */
        @media (max-width: 600px) {
            .decoration { width: 50px; }
            .modal-content { padding: 25px; }
            .modal-title { font-size: 2.5rem; }
        }
    </style>
</head>
<body>

    <div class="decoration left-decor"></div>
    <div class="decoration right-decor"></div>

    <div class="heart-wrapper" style="text-align: center;">
        <div class="heart-container" id="heartBtn">
            <div class="heart"></div>
        </div>
        <div class="click-hint">Нажми на сердце</div>
    </div>

    <div class="modal-overlay" id="modal">
        <div class="modal-content">
            <h1 class="modal-title">Приглашение</h1>
            <p class="modal-text">
                Я хочу пригласить тебя на свидание.<br>
                Дресс код: удобное для активности 
            </p>
            
            <div class="details-box">
                <p><strong>📅 Когда:</strong> В Субботу вечером</p>
                <p><strong>📍 Где:</strong> Это секрет</p>
            </div>

            <button class="close-btn" onclick="closeModal()">Я согласна!</button>
        </div>
    </div>

    <script>
        const modal = document.getElementById('modal');
        const closeBtn = document.querySelector('.close-btn');


        heartBtn.addEventListener('click', () => {
            modal.classList.add('active');
        });


        function closeModal() {
            modal.classList.remove('active');

            setTimeout(() => {
                alert("Ура! Жду не дождусь встречи! ❤️");
            }, 500);
        }

        modal.addEventListener('click', (e) => {
            if (e.target === modal) {
                closeModal();
            }
        });
    </script>

</body>
</html>
